\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The macOS Gatekeeper ``damaged'' dialog that appears when double-clicking an unsigned \texttt  {.app} bundle downloaded from the internet. The application is not corrupted; the message reflects the absence of an Apple notarization certificate. Right-clicking the app and selecting \emph  {Open}, then confirming in the second dialog, bypasses the restriction permanently for that binary.}}{18}{figure.3}\protected@file@percent }
\newlabel{fig:gatekeeper-damaged}{{3}{18}{The macOS Gatekeeper ``damaged'' dialog that appears when double-clicking an unsigned \texttt {.app} bundle downloaded from the internet. The application is not corrupted; the message reflects the absence of an Apple notarization certificate. Right-clicking the app and selecting \emph {Open}, then confirming in the second dialog, bypasses the restriction permanently for that binary}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The Privacy \& Security pane in macOS System Settings showing a blocked unsigned application. Clicking \emph  {Open Anyway} and supplying the administrator password grants a permanent exception for that binary.}}{18}{figure.4}\protected@file@percent }
\newlabel{fig:gatekeeper-privacy}{{4}{18}{The Privacy \& Security pane in macOS System Settings showing a blocked unsigned application. Clicking \emph {Open Anyway} and supplying the administrator password grants a permanent exception for that binary}{figure.4}{}}
